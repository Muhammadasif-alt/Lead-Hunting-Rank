# ─── Revenue OS — local development environment ───
# Copy this file to `.env` (pnpm setup does it for you). Never commit `.env`.

APP_ENV=development
APP_URL=http://localhost:3000

# Logging: trace | debug | info | warn | error. LOG_PRETTY defaults to true in development (JSON otherwise).
LOG_LEVEL=info
# LOG_PRETTY=true

# API (NestJS)
API_PORT=4000
API_URL=http://localhost:4000

# PostgreSQL (Docker). Host port 5433 so it doesn't clash with a locally installed Postgres on 5432.
POSTGRES_USER=revenue_os
POSTGRES_PASSWORD=revenue_os_dev
POSTGRES_DB=revenue_os
POSTGRES_PORT=5433
DATABASE_URL=postgresql://revenue_os:revenue_os_dev@localhost:5433/revenue_os

# Redis (Docker). Host port 6380 so it doesn't clash with a local Redis on 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# AI provider (not needed until Phase 9 — AI Runtime). Non-fake providers require LLM_API_KEY.
LLM_PROVIDER=fake
LLM_API_KEY=

# File storage (KB documents, snapshots, exports)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Encrypts OAuth tokens / provider credentials at rest. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
