{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --noClear --onFirstSuccess \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@revenue-os/config": "workspace:*",
    "@revenue-os/database": "workspace:*",
    "@revenue-os/events": "workspace:*",
    "@revenue-os/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsc-watch": "^7",
    "typescript": "~5.9.3"
  }
}
