{
  "name": "revenue-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml --env-file .env down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml --env-file .env logs -f",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"./packages/*\" --filter api --filter worker --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "db:generate": "pnpm --filter @revenue-os/database db:generate",
    "db:migrate": "pnpm --filter @revenue-os/database db:migrate",
    "db:studio": "pnpm --filter @revenue-os/database db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~5.9.3"
  }
}
